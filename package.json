{
  "name": "@dakotajp/agency",
  "version": "0.3.0",
  "private": true,
  "description": "Agents at your command, across all your computers: agents, their sessions, the requests that start them and the hosts they run on.",
  "type": "module",
  "bin": {
    "agency": "dist/cli.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node src/cli.ts --db .agency-dev.db",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node src/build.ts dist/build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "spec": "node src/spec.ts",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@hono/node-server": "^2.1.5",
    "@hono/zod-openapi": "^1.6.3",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "hono": "^4.6.0",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@redocly/cli": "^2.71.1",
    "@types/node": "^24",
    "@types/ws": "^8.18.2",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.7.2",
    "vitest": "^5.0.5"
  }
}
