#!/bin/sh
# agent-host SOURCE HOST_ID CAPACITY LABELS: run on a host after ops/deploy.
# Installs SOURCE (a clean checkout of dakotacolorado/agent-host, which runs on
# Node 24 and the Claude Agent SDK) as
# ~/.local/share/routines/agent-host/versions/<version>+<commit>, points
# current at it (the one it replaces is previous), writes
# ~/.config/agent-host/config.toml (mode 600) pointing it at this host's
# agent-service with its AUTH_TOKEN, writes and restarts agent-host.service,
# and waits for agent-service to list HOST_ID as connected. LABELS is
# comma-separated, e.g. linux,x86_64. agent-host runs beside worker-host,
# sharing none of its files; its sessions use this user's Claude login.
set -eu
[ $# -eq 4 ] || { echo "usage: agent-host SOURCE HOST_ID CAPACITY LABELS" >&2; exit 2; }
source=$(cd "$1" && pwd) host_id=$2 capacity=$3 labels=$4
here=$(cd "$(dirname "$0")" && pwd)
. "$here/common"
[ -f "$source/package.json" ] && [ -f "$source/src/cli.ts" ] || { echo "agent-host: $source is not an agent-host checkout" >&2; exit 1; }
[ -z "$(git -C "$source" status --porcelain)" ] || { echo "agent-host: $source has uncommitted changes" >&2; exit 1; }
commit=$(git -C "$source" rev-parse HEAD)
version=$("$node" -p "require('$source/package.json').version")+$(printf %.7s "$commit")

apps=$routines/agent-host
dest=$apps/versions/$version
if [ ! -d "$dest" ]; then
  mkdir -p "$dest.partial"
  cp -R "$source/src" "$source/package.json" "$source/package-lock.json" "$dest.partial/"
  (cd "$dest.partial" && npm ci --omit=dev --no-audit --no-fund) >&2
  mv "$dest.partial" "$dest"
fi
was=$(readlink "$apps/current" 2>/dev/null || true)
if [ "$was" != "versions/$version" ]; then
  [ -n "$was" ] && echo "$was" >"$apps/previous"
  ln -sfn "versions/$version" "$apps/current.new"
  mv -T "$apps/current.new" "$apps/current"
fi
"$node" "$apps/current/src/cli.ts" --help >/dev/null 2>&1 || { echo "agent-host: $version does not run here" >&2; exit 1; }
echo "agent-host: $apps/current is $version (was ${was:-nothing})"
# The Rust build this replaces, if an earlier install left it.
rm -f "$HOME/.local/bin/agent-host"

host_conf=$HOME/.config/agent-host
quoted=$(printf '%s' "$labels" | sed 's/[^,][^,]*/"&"/g; s/,/, /g')
umask 077
mkdir -p "$host_conf"
cat >"$host_conf/config.toml.new" <<TOML
service_url = "$url"
token = "$(token AUTH_TOKEN)"
host_id = "$host_id"
capacity = $capacity
labels = [$quoted]
TOML
mv "$host_conf/config.toml.new" "$host_conf/config.toml"
umask 022

mkdir -p "$units"
cat >"$units/agent-host.service" <<UNIT
[Unit]
Description=agent-host: this machine's place among $app's hosts (dakotacolorado/agent-service ops/)
After=network-online.target $app.service
Wants=network-online.target

[Service]
ExecStart=$node %h/.local/share/routines/agent-host/current/src/cli.ts
Restart=always
RestartSec=5
Environment=PATH=%h/.local/bin:$(dirname "$node"):/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin

[Install]
WantedBy=default.target
UNIT
systemctl --user daemon-reload
systemctl --user enable agent-host.service >/dev/null 2>&1
systemctl --user restart agent-host.service

i=0
while [ $i -lt 30 ]; do
  if printf 'Authorization: Bearer %s\n' "$(token AUTH_TOKEN)" | curl -fsS -H @- "$url/hosts?status=connected" 2>/dev/null | grep -q "\"id\":\"$host_id\""; then
    echo "agent-host: $host_id is connected to $url"
    exit 0
  fi
  i=$((i + 1))
  sleep 1
done
echo "agent-host: $host_id did not connect to $url" >&2
journalctl --user -u agent-host.service -n 20 --no-pager >&2 || true
exit 1
