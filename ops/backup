#!/bin/sh
# backup STAGE OTHER_HOST: copies a consistent backup of this host's
# agent-service database to OTHER_HOST over the tailnet, as
# ~/backups/agent-service/agent-service-STAGE-<date>.db there, and keeps 14 days
# of them. Run by agent-service-backup.timer, which ops/deploy installs.
set -eu
umask 077
[ $# -eq 2 ] || { echo "usage: backup STAGE OTHER_HOST" >&2; exit 2; }
stage=$1 other=$2
. "$(dirname "$0")/common"
name=agent-service-$stage-$(date -u +%F).db
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
"$node" "$routines/$app/current/dist/cli.js" backup --db "$data/agent-service.db" "$tmp/$name"
ssh -o BatchMode=yes "$other" 'mkdir -p ~/backups/agent-service'
scp -q -o BatchMode=yes "$tmp/$name" "$other:backups/agent-service/$name.partial"
ssh -o BatchMode=yes "$other" "mv ~/backups/agent-service/$name.partial ~/backups/agent-service/$name && find ~/backups/agent-service -name 'agent-service-$stage-*.db' -mtime +13 -delete"
echo "backup: $name is on $other"
