# Sourced by ops/ scripts: where agent-service lives on a host, and how to reach it.
app=agent-service
port=4600
https_port=8446
conf=$HOME/.config/agent-service
data=$HOME/.local/share/agent-service
routines=$HOME/.local/share/routines
units=$HOME/.config/systemd/user

# Node 24 from PATH, else the per-user install the HP has.
node=$(command -v node || true)
[ -n "$node" ] || { [ -x "$HOME/.local/bin/node" ] && node=$HOME/.local/bin/node; }
[ -n "$node" ] && [ -x "$node" ] || { echo "$app: no node on $(hostname)" >&2; exit 1; }
PATH=$(dirname "$node"):$PATH
export PATH

# This host's MagicDNS name, without its trailing dot, and the service's address on it.
dns=$(tailscale status --self --json | "$node" -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>console.log(JSON.parse(s).Self.DNSName.replace(/\.$/,"")))')
url=https://$dns:$https_port

# The host's other services, as each is served on it.
honed_url=https://$dns:8443
waypoint_url=https://$dns:8444

# A value from the service's env file, which only this host has.
token() { sed -n "s/^$1=//p" "$conf/env"; }
