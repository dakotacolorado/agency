#!/bin/sh
# page STATUS 'one line' ['headline']  -- say whether you need the person, and what on.
#
#   page working 'Waiting on 3 review subagents for PR #41' 'Reviewing PR #41'
#   page waiting 'Which schema should the status field use?' 'Asks: status schema'
#   page review 'PR #41 is submitted to approval-service; ticket in review' 'In review: PR #41'
#
# STATUS is one PutAgentStatus takes (reference/api.md); the service refuses any other.
#
# Prints the agent as agency now has it. Exits 1 on an HTTP error.
#
# The address and token come from the session's environment, which every
# session is started with; the token is never printed. The agent is the one
# whose folder holds CLAUDE_CONFIG_DIR (<agents>/<name>/home/.claude), by the
# id in its agent.json.
#
# Env: AGENCY_URL and AGENCY_TOKEN (set for the session); AGENCY_AGENT_ID overrides
# the agent. AG_URL, AG_TOKEN and AG_AGENT_ID, their names before agency was
# renamed from agent-service, are read when those are not set.
set -eu

usage() { sed -n '2,8p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2; }
[ $# -eq 2 ] || [ $# -eq 3 ] || usage
status=$1 summary=$2 headline=${3-}

url=${AGENCY_URL:-${AG_URL:-}}
token=${AGENCY_TOKEN:-${AG_TOKEN:-}}
[ -n "$url" ] || { echo "page: AGENCY_URL is not set: this session was started without agency's address" >&2; exit 1; }
[ -n "$token" ] || { echo "page: AGENCY_TOKEN is not set: this session was started without agency's token" >&2; exit 1; }

agent=${AGENCY_AGENT_ID:-${AG_AGENT_ID:-}}
if [ -n "$agent" ]; then
  id=$agent
else
  config=${CLAUDE_CONFIG_DIR:?"page: CLAUDE_CONFIG_DIR is not set, so which agent this is is unknown"}
  file=$(dirname "$(dirname "$config")")/agent.json
  id=$(sed -n 's/.*"id"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$file" | head -n 1)
  [ -n "$id" ] || { echo "page: no agent id in $file" >&2; exit 1; }
fi

# One line, as JSON: backslashes and quotes escaped, line breaks and tabs made spaces.
one() { printf %s "$1" | tr '\n\r\t' '   ' | sed 's/\\/\\\\/g; s/"/\\"/g'; }
line=$(one "$summary")
body="{\"status\":\"$(one "$status")\",\"summary\":\"$line\""
[ -z "$headline" ] || body="$body,\"headline\":\"$(one "$headline")\""
body="$body}"

out=$(mktemp)
trap 'rm -f "$out"' EXIT
# The token goes in by a header file on stdin, so it is never on a command line.
code=$(printf 'authorization: Bearer %s\n' "$token" | curl -sS -o "$out" -w '%{http_code}' -X PUT -H @- \
  -H 'content-type: application/json' --data-binary "$body" \
  "${url%/}/agents/$id/status")

cat "$out"
[ -s "$out" ] && [ "$(tail -c1 "$out")" != "" ] && echo
if [ "$code" -ge 400 ]; then
  echo "page: HTTP $code" >&2
  exit 1
fi
