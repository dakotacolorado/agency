#!/bin/sh
# title 'a few words'  -- name yourself, once, for the work you are here to do.
#
#   title 'Short status headline'
#
# Prints the agent as agent-service now has it. Exits 1 on an HTTP error,
# and 409 once you have a title: only the person changes it after that.
#
# Env: AG_URL and AG_TOKEN (set for the session); AG_AGENT_ID overrides the agent.
set -eu

usage() { sed -n '2,4p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2; }
[ $# -eq 1 ] || usage

url=${AG_URL:?"title: AG_URL is not set: this session was started without agent-service's address"}
token=${AG_TOKEN:?"title: AG_TOKEN is not set: this session was started without agent-service's token"}

if [ -n "${AG_AGENT_ID-}" ]; then
  id=$AG_AGENT_ID
else
  config=${CLAUDE_CONFIG_DIR:?"title: CLAUDE_CONFIG_DIR is not set, so which agent this is is unknown"}
  file=$(dirname "$(dirname "$config")")/agent.json
  id=$(sed -n 's/.*"id"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$file" | head -n 1)
  [ -n "$id" ] || { echo "title: no agent id in $file" >&2; exit 1; }
fi

name=$(printf %s "$1" | tr '\n\r\t' '   ' | sed 's/\\/\\\\/g; s/"/\\"/g')

out=$(mktemp)
trap 'rm -f "$out"' EXIT
# The token goes in by a header file on stdin, so it is never on a command line.
code=$(printf 'authorization: Bearer %s\n' "$token" | curl -sS -o "$out" -w '%{http_code}' -X PUT -H @- \
  -H 'content-type: application/json' --data-binary "{\"title\":\"$name\"}" \
  "${url%/}/agents/$id/title")

cat "$out"
[ -s "$out" ] && [ "$(tail -c1 "$out")" != "" ] && echo
if [ "$code" -ge 400 ]; then
  echo "title: HTTP $code" >&2
  exit 1
fi
